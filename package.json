{
  "name": "shikshasetu-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "vercel-build": "prisma generate && DATABASE_URL=file:./data/seed.db prisma db push --skip-generate && DATABASE_URL=file:./data/seed.db node prisma/seed.js && vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:seed-school-routine": "node prisma/seed-school-routine.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.107.1",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dexie": "^4.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^6.30.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.3.5",
    "vite": "^6.3.5"
  }
}
